PORT=3003
DATABASE_URL=/app/data/coach.db
COACH_DATA_DIR=/absolute/private/path/to/coach-data
COACH_BIND_IP=127.0.0.1
COACH_PORT=3004
# Explicit owner from migration preview. Never infer among multiple legacy athletes.
COACH_OWNER_ATHLETE_ID=
# Analyze only new activities from the chosen cutover date (local activity date).
COACH_SINCE=
# First deploy disabled. Enable after migration and delivery-path verification.
COACH_ENABLED=false
COACH_SEND_NOTIFICATIONS=false
COACH_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
NOTIFICATION_WEBHOOK_URL=
# Independently generated secrets, at least 32 characters each.
COACH_INGEST_TOKEN=
ADMIN_TOKEN=
SESSION_SECRET=
COOKIE_SECURE=true
COACH_REPORT_URL=
