# cp .env.example .env 후 값을 채우세요. .env 는 커밋되지 않습니다.

# 프로젝트 루트의 **절대경로**.
# 호스트와 동일한 경로로 마운트해야 한다 — Iceberg 의 hadoop 카탈로그가
# 테이블 location 을 절대경로로 메타데이터에 박기 때문이다.
TC_PROJECT_PATH=/absolute/path/to/training-companion

# Linux 호스트에서만: 프로젝트 폴더 소유자의 uid (`id -u`). 맥은 비워 둔다.
# 비우면 50000 으로 돌아 Linux 에서는 warehouse 쓰기가 Permission denied 로 실패한다.
AIRFLOW_UID=

# 로컬 스택 자격증명. 기본값 없음 — 직접 정하세요.
#   openssl rand -hex 32   (JWT 시크릿)
#   openssl rand -hex 16   (비밀번호)
#
# ⚠️ 비밀번호는 **16진수/영숫자만** 쓸 것.
#    POSTGRES_PASSWORD 는 접속 URL 에 그대로 들어가서 @ : / # % 가 있으면
#    SQLAlchemy 가 호스트를 잘못 파싱한다 (인증 오류가 아니라 접속 오류로 보임).
#
# ⚠️ POSTGRES_PASSWORD 는 postgres 볼륨이 **비어 있을 때만** 적용된다.
#    이미 띄운 적이 있다면 값을 바꿔도 반영되지 않는다 —
#    `docker compose down -v` (Airflow 메타데이터 전부 삭제) 후 다시 올리거나
#    컨테이너 안에서 ALTER USER 로 직접 바꿔야 한다.
AIRFLOW_JWT_SECRET=
POSTGRES_PASSWORD=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# 실패 알림 (ntfy.sh). 폰에 ntfy 앱을 깔고 이 토픽을 구독한다.
# 공개 서버라 토픽을 아는 사람은 누구나 구독할 수 있다 — 추측하기 어렵게:
#   echo "trisplit-$(openssl rand -hex 12)"
# 비워 두면 알림 없이 돈다.
NTFY_TOPIC=

# Strava 웹훅 수신기 (webhook/receiver.py)
# 공유 Strava 앱이면 다른 사용자의 이벤트도 들어오므로 내 athlete_id 로 거른다 (필수).
#   config.json 의 athlete_id 값
STRAVA_ATHLETE_ID=
# 구독 id — GET https://www.strava.com/api/v3/push_subscriptions 로 확인. 비우면 검사 안 함.
STRAVA_SUBSCRIPTION_ID=
# 구독을 직접 가질 때만 (mirror 구성이면 비워 둔다)
STRAVA_VERIFY_TOKEN=
