# cp .env.example .env 후 값을 채우세요. .env 는 커밋되지 않습니다.

# 프로젝트 루트의 **절대경로**.
# 호스트와 동일한 경로로 마운트해야 한다 — Iceberg 의 hadoop 카탈로그가
# 테이블 location 을 절대경로로 메타데이터에 박기 때문이다.
TC_PROJECT_PATH=/absolute/path/to/training-companion

# 로컬 스택 자격증명. 기본값 없음 — 직접 정하세요.
#   openssl rand -hex 32   (JWT 시크릿)
#   openssl rand -hex 16   (비밀번호)
#
# ⚠️ 비밀번호는 **16진수/영숫자만** 쓸 것.
#    POSTGRES_PASSWORD 는 접속 URL 에 그대로 들어가서 @ : / # % 가 있으면
#    SQLAlchemy 가 호스트를 잘못 파싱한다 (인증 오류가 아니라 접속 오류로 보임).
#
# ⚠️ POSTGRES_PASSWORD 는 postgres 볼륨이 **비어 있을 때만** 적용된다.
#    이미 띄운 적이 있다면 값을 바꿔도 반영되지 않는다 —
#    `docker compose down -v` (Airflow 메타데이터 전부 삭제) 후 다시 올리거나
#    컨테이너 안에서 ALTER USER 로 직접 바꿔야 한다.
AIRFLOW_JWT_SECRET=
POSTGRES_PASSWORD=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
